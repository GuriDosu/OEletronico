@model OEletronico.Models.DTOs.MovimentacaoDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Movimentar Quantidade";
}

<div style="max-width: 500px; margin: 40px auto; padding: 0 20px;">
    <div class="card form-card" style="background: #ffffff; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); overflow: hidden;">
        
        <!-- Cabeçalho do Card -->
        <div style="padding: 24px; border-bottom: 1px solid #e5e7eb; background-color: #f9fafb;">
            <h3 style="margin: 0; font-size: 18px; color: #111827; font-weight: 700;">🔄 Movimentar Produto</h3>
            <p style="margin: 4px 0 0 0; font-size: 13px; color: #6b7280;">Registre entradas de mercadoria ou saídas para vendas</p>
        </div>

        <div style="padding: 24px;">
            <!-- Informação Destacada -->
            <div style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
                <div style="font-size: 15px; color: #1e3a8a; font-weight: 700; margin-bottom: 4px;">📦 @ViewBag.ProdutoNome</div>
                <div style="font-size: 13px; color: #1e40af;">Quantidade atual no sistema: <strong style="font-size: 15px;">@ViewBag.QuantidadeAtual unidades</strong></div>
            </div>

            <!-- Passando a categoria atual na rota do form para manter o filtro -->
            <form asp-action="Movimentar" asp-route-categoria="@ViewBag.CategoriaAtual" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProdutoId" />

                <div style="margin-bottom: 20px;">
                    <label asp-for="Tipo" style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: #374151;">Tipo de Movimentação</label>
                    <select id="Tipo" name="Tipo" style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid #d1d5db; background-color: #fff; cursor: pointer; font-size: 14px;">
                        <option value="">Selecione...</option>
                        <option value="Entrada">📥 Entrada (Aumentar estoque)</option>
                        <option value="Saída">📤 Saída (Diminuir estoque)</option>
                    </select>
                    <span class="text-danger" data-valmsg-for="Tipo" data-valmsg-replace="true" style="font-size: 12px; margin-top: 4px; display: block;"></span>
                </div>

                <div style="margin-bottom: 30px;">
                    <label asp-for="Quantidade" style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: #374151;">Quantidade</label>
                    <input id="Quantidade" name="Quantidade" type="number" min="1" value="0" style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid #d1d5db; font-size: 14px;" />
                    <span class="text-danger" data-valmsg-for="Quantidade" data-valmsg-replace="true" style="font-size: 12px; margin-top: 4px; display: block;"></span>
                </div>

                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <!-- Botão cancelar devolvendo para a categoria correta -->
                    <a asp-action="Index" asp-route-categoria="@ViewBag.CategoriaAtual" style="padding: 10px 20px; border-radius: 8px; border: 1px solid #d1d5db; background: #ffffff; color: #374151; text-decoration: none; font-size: 14px; font-weight: 600; display: inline-flex; align-items: center;">Cancelar</a>
                    <button type="submit" style="padding: 10px 20px; border-radius: 8px; border: none; background: #2563eb; color: #ffffff; cursor: pointer; font-size: 14px; font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">✓ Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<ElicitationsGroup></ElicitationsGroup>