<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — O Eletrônico</title>
    
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
    
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
            /* ═══════════════════════════════════════════════════
                       SIDEBAR: só ícones por padrão, expande ao passar o mouse
                    ═══════════════════════════════════════════════════ */
            #sidebar {
                width: 72px;
                transition: width 0.2s ease;
                overflow: hidden;
                flex-shrink: 0;
            }

                #sidebar:hover {
                    width: 224px;
                }

                /* Esconde textos por padrão */
                #sidebar .logo-text,
                #sidebar .user-text,
                #sidebar .nav-section,
                #sidebar .nav-label {
                    display: none;
                }

                /* Mostra textos ao passar o mouse */
                #sidebar:hover .logo-text,
                #sidebar:hover .user-text {
                    display: block;
                }

                #sidebar:hover .nav-section {
                    display: block;
                }

                #sidebar:hover .nav-label {
                    display: inline;
                }

            .logo-icon-collapsed {
                display: block;
                font-size: 22px;
                text-align: center;
            }

            #sidebar:hover .logo-icon-collapsed {
                display: none;
            }

            .sidebar-logo,
            .sidebar-user {
                justify-content: center;
            }

            #sidebar:hover .sidebar-logo,
            #sidebar:hover .sidebar-user {
                justify-content: flex-start;
            }

            #sidebar .nav-item,
            #sidebar .logout-link {
                justify-content: center;
            }

            #sidebar:hover .nav-item,
            #sidebar:hover .logout-link {
                justify-content: flex-start;
            }
    </style>
</head>
<body>
    <div id="app-layout">

        <aside id="sidebar">
            <div class="sidebar-logo" style="text-align:center;">
                <span class="logo-icon-collapsed">⚡</span>
                <div class="logo-text">
                    <div class="logo-name">O Eletrônico</div>
                    <div class="logo-sub">Gestão Empresarial</div>
                </div>
            </div>

            <div class="sidebar-user">
                <div class="user-avatar">@(Context.Session.GetString("UserInitials") ?? "??")</div>
                <div class="user-text">
                    <div class="user-name">@(Context.Session.GetString("UserName") ?? "Usuário")</div>
                    <div class="user-role">@(Context.Session.GetString("UserCargo") ?? "")</div>
                </div>
            </div>

            <nav class="sidebar-nav">

                <!-- ─── GERAL (TODOS) ─── -->
                <div class="nav-section">Geral</div>
                <a class="nav-item" asp-controller="Pessoa" asp-action="Perfil" title="Meu Perfil">
                    <span class="nav-icon">👤</span><span class="nav-label">Meu Perfil</span>
                </a>
                <a class="nav-item" asp-controller="Produto" asp-action="Index" title="Produtos">
                    <span class="nav-icon">📦</span><span class="nav-label">Produtos</span>
                </a>
                <a class="nav-item" asp-controller="Movimentacao" asp-action="Index" title="Movimentação">
                    <span class="nav-icon">🗃️</span><span class="nav-label">Movimentação</span>
                </a>

                @if (Context.Session.GetString("UserCargo") != "Admin")
                {
                    <!-- ─── PONTO (SÓ COLABORADOR) ─── -->
                    <div class="nav-section">Ponto</div>
                    <a class="nav-item" asp-controller="RegistroPonto" asp-action="Index" title="Bater Ponto">
                        <span class="nav-icon">🕐</span><span class="nav-label">Bater Ponto</span>
                    </a>
                    <a class="nav-item" asp-controller="BancoHoras" asp-action="Index" title="Meu Banco de Horas">
                        <span class="nav-icon">💼</span><span class="nav-label">Meu Banco de Horas</span>
                    </a>
                }

                @if (Context.Session.GetString("UserCargo") == "Admin")
                {
                    <!-- ─── ADMINISTRAÇÃO (SÓ ADMIN) ─── -->
                    <div class="nav-section">Administração</div>

                    <a class="nav-item" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                        <span class="nav-icon">📈</span><span class="nav-label">Dashboard</span>
                    </a>

                    <a class="nav-item" asp-controller="Pessoa" asp-action="Index" title="Colaboradores">
                        <span class="nav-icon">👥</span><span class="nav-label">Colaboradores</span>
                    </a>
                    <a class="nav-item" asp-controller="BancoHoras" asp-action="Admin" title="Banco de Horas">
                        <span class="nav-icon">📊</span><span class="nav-label">Banco de Horas</span>
                    </a>
                }

            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Auth" asp-action="Logout" class="logout-link" title="Sair">
                    <span>⏻</span><span class="nav-label">Sair</span>
                </a>
            </div>
        </aside>

        <div id="main-area">
            <header id="topbar">
                <span class="topbar-title">@ViewData["Title"]</span>
                <div class="topbar-right">
                    <span id="topbar-date" class="topbar-date"></span>
                    <div class="topbar-avatar">@(Context.Session.GetString("UserInitials") ?? "??")</div>
                </div>
            </header>

            <main id="page-content">
                @if (TempData["Sucesso"] != null)
                {
                    <div class="alert-sucesso">✓ @TempData["Sucesso"]</div>
                }
                @if (TempData["Erro"] != null)
                {
                    <div class="alert-erro-top">⚠ @TempData["Erro"]</div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>