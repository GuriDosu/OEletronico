@model OEletronico.Models.Cnpj
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Novo CNPJ";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Novo CNPJ</h1>
        <p class="page-sub">Cadastre um contrato para vincular aos colaboradores</p>
    </div>
</div>

<div class="card form-layout">
    <div class="card-header">
        <span class="card-header-icon">🏢</span>
        <span class="card-header-title">Dados do contrato</span>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="field-group full">
                    <label asp-for="Numero">CNPJ <span class="required">*</span></label>
                    <input asp-for="Numero" placeholder="00.000.000/0000-00" maxlength="18" autocomplete="off" />
                    <span asp-validation-for="Numero" class="field-error"></span>
                </div>

                <div class="field-group full">
                    <label asp-for="RazaoSocial">Razão Social <span class="required">*</span></label>
                    <input asp-for="RazaoSocial" placeholder="Ex: Duartec" />
                    <span asp-validation-for="RazaoSocial" class="field-error"></span>
                </div>

                <div class="field-group full">
                    <label asp-for="NomeFantasia">Nome Fantasia</label>
                    <input asp-for="NomeFantasia" placeholder="Ex: Duartec" />
                    <span asp-validation-for="NomeFantasia" class="field-error"></span>
                </div>
            </div>

            <div class="info-box">
                💡 Depois de cadastrado, este CNPJ poderá ser vinculado aos colaboradores
                na tela de Colaboradores.
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn">Cancelar</a>
                <button type="submit" class="btn btn-primary">Cadastrar CNPJ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Máscara automática: 00.000.000/0000-00
        var campoCnpj = document.querySelector('input[name="Numero"]');
        campoCnpj.addEventListener('input', function () {
            var v = this.value.replace(/\D/g, '').substring(0, 14);
            v = v.replace(/^(\d{2})(\d)/, '$1.$2');
            v = v.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
            v = v.replace(/\.(\d{3})(\d)/, '.$1/$2');
            v = v.replace(/(\d{4})(\d)/, '$1-$2');
            this.value = v;
        });
    </script>
}