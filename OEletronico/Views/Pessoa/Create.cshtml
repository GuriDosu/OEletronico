@model OEletronico.Models.DTOs.PessoaDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Novo Colaborador";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Novo colaborador</h1>
        <p class="page-sub">Preencha os dados para cadastrar um novo usuário</p>
    </div>
    <a asp-action="Index" class="btn btn-outline">← Voltar</a>
</div>

<div class="form-layout">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="card form-card">
            <div class="card-header">
                <span class="card-header-icon">👤</span>
                <span class="card-header-title">Dados pessoais</span>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field-group full">
                        <label asp-for="Nome">Nome completo <span class="required">*</span></label>
                        <input asp-for="Nome" placeholder="Ex.: João da Silva" />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>

                    <div class="field-group full">
                        <label asp-for="Email">Email <span class="required">*</span></label>
                        <input asp-for="Email" type="email" placeholder="joao.silva@empresa.com" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Cargo">Cargo <span class="required">*</span></label>
                        <select asp-for="Cargo">
                            <option value="">Selecione...</option>
                            <option value="CLT">CLT</option>
                            <option value="Estagiario">Estagiário</option>
                        </select>
                        <span asp-validation-for="Cargo" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Setor">Setor <span class="required">*</span></label>
                        <input asp-for="Setor" placeholder="Ex.: TI, Financeiro" />
                        <span asp-validation-for="Setor" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="DataAdmissao">Data de admissão <span class="required">*</span></label>
                        <input asp-for="DataAdmissao" type="date" />
                        <span asp-validation-for="DataAdmissao" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card form-card" style="margin-top:20px">
            <div class="card-header">
                <span class="card-header-icon">🔐</span>
                <span class="card-header-title">Acesso ao sistema</span>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field-group">
                        <label asp-for="Login">Login <span class="required">*</span></label>
                        <input asp-for="Login" placeholder="nome.sobrenome" />
                        <span asp-validation-for="Login" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Senha">Senha inicial <span class="required">*</span></label>
                        <input asp-for="Senha" type="password" placeholder="Mín. 6 caracteres" />
                        <span asp-validation-for="Senha" class="field-error"></span>
                    </div>
                </div>
                <div class="info-box">
                    <span class="info-icon">ℹ</span>
                    O colaborador poderá alterar a senha após o primeiro acesso.
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button type="submit" class="btn btn-primary">✓ Cadastrar colaborador</button>
        </div>
    </form>
</div>