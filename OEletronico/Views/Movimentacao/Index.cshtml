@model IEnumerable<OEletronico.Models.MovimentacaoEstoque>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Movimentação";
    var produtos = ViewBag.Produtos as List<OEletronico.Models.Produto> ?? new List<OEletronico.Models.Produto>();
    var totalEntradas = Model.Where(m => m.Tipo == "Entrada").Sum(m => m.Quantidade);
    var totalSaidas = Model.Where(m => m.Tipo == "Saida").Sum(m => m.Quantidade);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Movimentação de Estoque</h1>
        <p class="page-sub">Gerencie o estoque cadastrando produtos e registrando movimentações</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a asp-action="Cadastrar" class="btn">📝 Cadastrar produto</a>
        <a asp-action="Movimentar" class="btn btn-primary">🔄 Movimentar estoque</a>
    </div>
</div>

<!-- CARDS DE RESUMO -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">
    <div class="card" style="margin:0;padding:18px 20px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;margin-bottom:6px;">📋 TOTAL DE MOVIMENTAÇÕES</div>
        <div style="font-size:26px;font-weight:700;color:#111827;">@Model.Count()</div>
    </div>
    <div class="card" style="margin:0;padding:18px 20px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;margin-bottom:6px;">📥 ENTRADAS</div>
        <div style="font-size:26px;font-weight:700;color:#16a34a;">+@totalEntradas un.</div>
    </div>
    <div class="card" style="margin:0;padding:18px 20px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;margin-bottom:6px;">📤 SAÍDAS</div>
        <div style="font-size:26px;font-weight:700;color:#dc2626;">-@totalSaidas un.</div>
    </div>
</div>

<!-- FILTROS -->
<form method="get" asp-action="Index">
    <div class="filter-bar">
        <select name="tipoFiltro" onchange="this.form.submit()">
            <option value="">Todos os tipos</option>
            <option value="Entrada" selected="@(ViewBag.TipoFiltro == "Entrada")">📥 Apenas Entradas</option>
            <option value="Saida" selected="@(ViewBag.TipoFiltro == "Saida")">📤 Apenas Saídas</option>
        </select>
        <select name="produtoId" onchange="this.form.submit()">
            <option value="0">Todos os produtos</option>
            @foreach (var p in produtos)
            {
                <option value="@p.Id" selected="@(ViewBag.ProdutoId == p.Id)">@p.Nome</option>
            }
        </select>
        <a asp-action="Index" class="btn">Limpar</a>
    </div>
</form>

<!-- TABELA -->
<div class="card">
    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Data/Hora</th>
                    <th>Tipo</th>
                    <th>Produto</th>
                    <th>Quantidade</th>
                    <th>Responsável</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var ehEntrada = m.Tipo == "Entrada";
                    var badgeClass = ehEntrada ? "badge-green" : "badge-red";
                    var tipoLabel = ehEntrada ? "📥 Entrada" : "📤 Saída";
                    var sinal = ehEntrada ? "+" : "-";
                    var corQtd = ehEntrada ? "#16a34a" : "#dc2626";

                    <tr>
                        <td>
                            <div style="font-size:13px;">@m.Data.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            <div style="font-size:11px;color:#6b7280;">@m.Data.ToLocalTime().ToString("HH:mm")</div>
                        </td>
                        <td><span class="badge @badgeClass">@tipoLabel</span></td>
                        <td>
                            <strong>@m.Produto.Nome</strong>
                            <div style="font-size:11px;color:#6b7280;">
                                <code style="background:#f3f4f6;padding:1px 6px;border-radius:3px;">@m.Produto.Codigo</code>
                            </div>
                        </td>
                        <td>
                            <span style="font-weight:700;color:@corQtd;font-size:14px;">@sinal@m.Quantidade un.</span>
                        </td>
                        <td>
                            <div style="font-size:13px;">@m.Pessoa.Nome</div>
                            <div style="font-size:11px;color:#6b7280;">@m.Pessoa.Cargo</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <p>Nenhuma movimentação registrada ainda.</p>
            <a asp-action="Cadastrar" class="btn btn-primary">Cadastrar primeiro produto</a>
        </div>
    }
</div>