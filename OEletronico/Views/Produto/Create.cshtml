@model OEletronico.Models.Produto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Novo Produto";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Novo produto</h1>
        <p class="page-sub">Cadastre um produto no catálogo do sistema</p>
    </div>
    <a asp-action="Index" class="btn btn-outline">← Voltar</a>
</div>

<!-- BLOCO DE ERROS DE VALIDAÇÃO (importante!) -->
@if (!ViewData.ModelState.IsValid)
{
    <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:14px 16px;margin-bottom:20px;color:#dc2626;">
        <strong>⚠ Verifique os erros abaixo:</strong>
        <ul style="margin:8px 0 0 20px;">
            @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@modelError.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="form-layout">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="card form-card">
            <div class="card-header">
                <span class="card-header-icon">📦</span>
                <span class="card-header-title">Dados do produto</span>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field-group">
                        <label asp-for="Codigo">Código <span class="required">*</span></label>
                        <input asp-for="Codigo" placeholder="Ex.: PRD-001" style="text-transform:uppercase" />
                        <span style="font-size:11px;color:#6b7280;">
                            Identificador único do produto
                        </span>
                        <span asp-validation-for="Codigo" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Quantidade">Quantidade inicial <span class="required">*</span></label>
                        <input asp-for="Quantidade" type="number" min="0" value="0" />
                        <span asp-validation-for="Quantidade" class="field-error"></span>
                    </div>

                    <div class="field-group full">
                        <label asp-for="Nome">Nome do produto <span class="required">*</span></label>
                        <input asp-for="Nome" placeholder="Ex.: Notebook Dell Inspiron 15" />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Preco">Preço unitário (R$) <span class="required">*</span></label>
                        <input asp-for="Preco" type="number" step="0.01" min="0" placeholder="0.00" />
                        <span asp-validation-for="Preco" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button type="submit" class="btn btn-primary">✓ Cadastrar produto</button>
        </div>
    </form>
</div>