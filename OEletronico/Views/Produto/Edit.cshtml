@model OEletronico.Models.Produto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar Produto";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Editar produto</h1>
        <p class="page-sub">Atualize os dados de <strong>@Model.Nome</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline">← Voltar</a>
</div>

<div class="form-layout">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card form-card">
            <div class="card-header">
                <span class="card-header-icon">📦</span>
                <span class="card-header-title">Dados do produto</span>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="field-group">
                        <label asp-for="Codigo">Código</label>
                        <input asp-for="Codigo" style="text-transform:uppercase" />
                        <span asp-validation-for="Codigo" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Quantidade">Quantidade</label>
                        <input asp-for="Quantidade" type="number" min="0" />
                        <span class="field-hint" style="font-size:11px;color:#6b7280;">
                            Para ajustes maiores, use movimentações de estoque
                        </span>
                        <span asp-validation-for="Quantidade" class="field-error"></span>
                    </div>

                    <div class="field-group full">
                        <label asp-for="Nome">Nome do produto</label>
                        <input asp-for="Nome" />
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Preco">Preço unitário (R$)</label>
                        <input asp-for="Preco" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Preco" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline">Cancelar</a>
            <button type="submit" class="btn btn-primary">✓ Salvar alterações</button>
        </div>
    </form>
</div>