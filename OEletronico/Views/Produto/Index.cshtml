@model IEnumerable<OEletronico.Models.Produto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Produtos";
    var ehAdmin = Context.Session.GetString("UserCargo") == "Admin";
    var totalProdutos = Model.Count();
    var totalEstoque = Model.Sum(p => p.Quantidade);
    var valorEstoque = Model.Sum(p => p.Preco * p.Quantidade);
}

<style>
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(17, 24, 39, 0.55);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.aberto { display: flex; }

    .modal-box {
        background: #fff;
        border-radius: 12px;
        width: 100%;
        max-width: 420px;
        padding: 24px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .modal-box h3 {
        font-size: 16px;
        font-weight: 700;
        color: #dc2626;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .modal-box p {
        font-size: 13px;
        color: #4b5563;
        margin-bottom: 10px;
        line-height: 1.5;
    }

    .modal-nome-alvo {
        font-weight: 700;
        color: #111827;
        background: #fee2e2;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .modal-box input[type="text"] {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 16px;
        outline: none;
    }
    .modal-box input[type="text"]:focus {
        border-color: #dc2626;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .modal-btn-cancelar {
        padding: 9px 16px;
        border-radius: 8px;
        border: 1.5px solid #e5e7eb;
        background: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-btn-confirmar {
        padding: 9px 16px;
        border-radius: 8px;
        border: none;
        background: #dc2626;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }
    .modal-btn-confirmar:disabled {
        background: #fca5a5;
        cursor: not-allowed;
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Produtos</h1>
        <p class="page-sub">
            @if (ehAdmin)
            {
                <span>Catálogo completo de produtos do sistema</span>
            }
            else
            {
                <span>Consulte os produtos disponíveis no estoque</span>
            }
        </p>
    </div>
    @if (ehAdmin)
    {
        <a asp-action="ExportarExcel" class="btn btn-primary">📊 Exportar planilha</a>
    }
</div>

<!-- CARDS DE RESUMO -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">
    <div class="card" style="margin:0;padding:18px 20px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;margin-bottom:6px;">📦 TOTAL DE PRODUTOS</div>
        <div style="font-size:26px;font-weight:700;color:#111827;">@totalProdutos</div>
    </div>
    <div class="card" style="margin:0;padding:18px 20px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;margin-bottom:6px;">📊 UNIDADES EM ESTOQUE</div>
        <div style="font-size:26px;font-weight:700;color:#2563eb;">@totalEstoque</div>
    </div>
    <div class="card" style="margin:0;padding:18px 20px;">
        <div style="font-size:12px;color:#6b7280;font-weight:600;margin-bottom:6px;">💰 VALOR TOTAL DO ESTOQUE</div>
        <div style="font-size:26px;font-weight:700;color:#16a34a;">R$ @valorEstoque.ToString("N2")</div>
    </div>
</div>

<!-- FILTROS -->
<form method="get" asp-action="Index">
    <div class="filter-bar">
        <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input type="text" name="busca" value="@ViewBag.Busca" placeholder="Buscar por nome ou código..." />
        </div>
        <select name="filtro" onchange="this.form.submit()">
            <option value="">Todos os estoques</option>
            <option value="normal" selected="@(ViewBag.Filtro == "normal")">Normal (10+)</option>
            <option value="baixo" selected="@(ViewBag.Filtro == "baixo")">Estoque baixo (&lt; 10)</option>
            <option value="esgotado" selected="@(ViewBag.Filtro == "esgotado")">Esgotado</option>
        </select>
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn">Limpar</a>
    </div>
</form>

<!-- TABELA -->
<div class="card">
    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Produto</th>
                    <th>Preço</th>
                    <th>Quantidade</th>
                    <th>Valor Total</th>
                    <th>Status</th>
                    @if (ehAdmin)
                    {
                        <th>Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var statusClass = "badge-green";
                    var statusText = "Em estoque";
                    if (p.Quantidade == 0)
                    {
                        statusClass = "badge-red";
                        statusText = "Esgotado";
                    }
                    else if (p.Quantidade < 10)
                    {
                        statusClass = "badge-amber";
                        statusText = "Estoque baixo";
                    }

                    <tr>
                        <td>
                            <code style="background:#f3f4f6;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:600;">@p.Codigo</code>
                        </td>
                        <td><strong>@p.Nome</strong></td>
                        <td>R$ @p.Preco.ToString("N2")</td>
                        <td><span style="font-weight:600;">@p.Quantidade</span> un.</td>
                        <td style="color:#16a34a;font-weight:600;">R$ @((p.Preco * p.Quantidade).ToString("N2"))</td>
                        <td><span class="badge @statusClass">@statusText</span></td>
                        @if (ehAdmin)
                        {
                            <td>
                                <div class="action-btns">
                                    <form id="formExcluir_@p.Id" asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:none">
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <button type="button" class="btn btn-sm btn-danger btn-excluir"
                                            data-id="@p.Id" data-nome="@p.Nome" title="Excluir">🗑</button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <p>Nenhum produto cadastrado ainda.</p>
            <p style="font-size:13px;color:#6b7280;">Cadastre produtos na aba <strong>🗃️ Movimentação</strong>.</p>
        </div>
    }
</div>


<div id="modalExcluir" class="modal-overlay">
    <div class="modal-box">
        <h3>⚠️ Excluir Produto</h3>
        <p>
            Esta ação é <strong>permanente</strong> e também apagará todo o
            histórico de movimentações deste produto.
        </p>
        <p>
            Digite <span class="modal-nome-alvo" id="modalNomeAlvo"></span> abaixo para confirmar:
        </p>
        <input type="text" id="modalInputConfirma" placeholder="Digite o nome do produto" autocomplete="off" />
        <div class="modal-actions">
            <button type="button" class="modal-btn-cancelar" onclick="fecharModalExcluir()">Cancelar</button>
            <button type="button" class="modal-btn-confirmar" id="modalBtnConfirmar" disabled onclick="confirmarExclusao()">
                Excluir Produto
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let produtoIdExcluir = null;
        let produtoNomeExcluir = null;

        document.querySelectorAll('.btn-excluir').forEach(function (btn) {
            btn.addEventListener('click', function () {
                produtoIdExcluir = this.dataset.id;
                produtoNomeExcluir = this.dataset.nome;

                document.getElementById('modalNomeAlvo').textContent = produtoNomeExcluir;
                document.getElementById('modalInputConfirma').value = '';
                document.getElementById('modalBtnConfirmar').disabled = true;
                document.getElementById('modalExcluir').classList.add('aberto');
                document.getElementById('modalInputConfirma').focus();
            });
        });

        document.getElementById('modalInputConfirma').addEventListener('input', function () {
            var digitado = this.value.trim().toLowerCase();
            var esperado = (produtoNomeExcluir || '').trim().toLowerCase();
            document.getElementById('modalBtnConfirmar').disabled = digitado !== esperado;
        });

        function fecharModalExcluir() {
            document.getElementById('modalExcluir').classList.remove('aberto');
            produtoIdExcluir = null;
            produtoNomeExcluir = null;
        }

        function confirmarExclusao() {
            if (!produtoIdExcluir) return;
            document.getElementById('formExcluir_' + produtoIdExcluir).submit();
        }

        document.getElementById('modalExcluir').addEventListener('click', function (e) {
            if (e.target === this) fecharModalExcluir();
        });
    </script>
}