@model IEnumerable<OEletronico.Models.Produto>

@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    .sb-dashboard {
        background-color: #f8f9fc;
        min-height: 100vh;
        padding-bottom: 2rem;
        font-family: 'Nunito', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Cards superiores com borda colorida SB Admin 2 */
    .sb-card {
        background: #ffffff;
        border: none;
        border-radius: 0.6rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        padding: 1.25rem;
        height: 110px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
    .border-left-info { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }

    .sb-card-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .sb-card-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: #5a5c69;
        margin-bottom: 0;
    }

    /* Ícone grande e semitransparente no canto do card (estilo SB Admin) */
    .sb-card-icon {
        position: absolute;
        right: 1.1rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.9rem;
        opacity: 0.25;
    }
    .sb-card-icon.text-success { color: #1cc88a; }
    .sb-card-icon.text-primary { color: #4e73df; }
    .sb-card-icon.text-info { color: #36b9cc; }
    .sb-card-icon.text-warning { color: #f6c23e; }

    /* Cards de Seção */
    .sb-section-card {
        background: #ffffff;
        border: none;
        border-radius: 0.6rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        margin-bottom: 1.5rem;
        height: 100%;
    }

    .sb-section-header {
        background-color: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
        padding: 0.75rem 1.25rem;
        font-weight: 700;
        font-size: 0.95rem;
        border-top-left-radius: 0.6rem;
        border-top-right-radius: 0.6rem;
    }

    .chart-container {
        position: relative;
        height: 270px;
        width: 100%;
    }

    .status-list-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #6e707e;
        margin-bottom: 4px;
        font-weight: 600;
    }

    /* Correção estética do Dropdown */
    .dropdown-menu {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        border-radius: 0.35rem;
        padding: 0.5rem 0;
    }

    .dropdown-item {
        color: #3a3b45;
        font-weight: 600;
        padding: 0.5rem 1.25rem;
        text-decoration: none !important;
    }

    .dropdown-item:hover, .dropdown-item:focus {
        background-color: #eaecf4;
        color: #4e73df;
        text-decoration: none !important;
    }

    .dropdown-item.active {
        background-color: #4e73df !important;
        color: #fff !important;
        text-decoration: none !important;
    }
</style>

<div class="container-fluid sb-dashboard pt-4">

    <!-- CABEÇALHO: TÍTULO + BOTÃO GERAR RELATÓRIO + FILTRO DE PERÍODO -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 fw-bold" style="color: #5a5c69 !important;">Dashboard</h1>

        <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">

            <!-- Botão de Filtrar Período com Menu Retrátil -->
            <div class="dropdown">
                <button class="btn btn-primary btn-sm dropdown-toggle shadow-sm px-3 py-2 fw-bold" type="button" id="filtroDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-calendar-alt me-1"></i> Período:
                    <span>
                        @(ViewBag.FiltroAtual == "dia" ? "Hoje" :
                          ViewBag.FiltroAtual == "semana" ? "Últimos 7 Dias" :
                          ViewBag.FiltroAtual == "mes" ? "Este Mês" :
                          ViewBag.FiltroAtual == "ano" ? "Este Ano" : "Todos os Registros")
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="filtroDropdown">
                    <li><a class="dropdown-item @(ViewBag.FiltroAtual == "dia" ? "active" : "")" href="@Url.Action("Index", new { filtro = "dia" })">Hoje</a></li>
                    <li><a class="dropdown-item @(ViewBag.FiltroAtual == "semana" ? "active" : "")" href="@Url.Action("Index", new { filtro = "semana" })">Últimos 7 Dias</a></li>
                    <li><a class="dropdown-item @(ViewBag.FiltroAtual == "mes" ? "active" : "")" href="@Url.Action("Index", new { filtro = "mes" })">Este Mês</a></li>
                    <li><a class="dropdown-item @(ViewBag.FiltroAtual == "ano" ? "active" : "")" href="@Url.Action("Index", new { filtro = "ano" })">Este Ano</a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item @(ViewBag.FiltroAtual == "tudo" ? "active" : "")" href="@Url.Action("Index", new { filtro = "tudo" })">Todos os Registros</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 1ª LINHA: 4 CARDS DE INDICADORES (agora com ícone, igual referência) -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sb-card border-left-success">
                <i class="fas fa-sack-dollar sb-card-icon text-success"></i>
                <div class="sb-card-title text-success">Entrada Financeira</div>
                <div class="sb-card-value">R$ @(((decimal)ViewBag.DinheiroEntrada).ToString("N2"))</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="sb-card border-left-primary">
                <i class="fas fa-warehouse sb-card-icon text-primary"></i>
                <div class="sb-card-title text-primary">Patrimônio Estoque</div>
                <div class="sb-card-value">R$ @(((decimal)ViewBag.ValorPatrimonioEstoque).ToString("N2"))</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="sb-card border-left-info">
                <i class="fas fa-arrow-down sb-card-icon text-info"></i>
                <div class="sb-card-title text-info">Total Entradas (Itens)</div>
                <div class="sb-card-value">@ViewBag.TotalEntradas un</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="sb-card border-left-warning">
                <i class="fas fa-arrow-up sb-card-icon text-warning"></i>
                <div class="sb-card-title text-warning">Total Saídas (Itens)</div>
                <div class="sb-card-value">@ViewBag.TotalSaidas un</div>
            </div>
        </div>
    </div>

    <!-- 2ª LINHA: GRÁFICO DE LINHA + GRÁFICO DE ROSCA -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8 col-lg-7">
            <div class="sb-section-card">
                <div class="sb-section-header text-primary">Visão Geral de Movimentação</div>
                <div class="card-body p-3">
                    <div class="chart-container">
                        <canvas id="earningsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="sb-section-card">
                <div class="sb-section-header text-primary">Fontes de Fluxo</div>
                <div class="card-body p-3 d-flex justify-content-center align-items-center" style="height: 315px;">
                    <div style="width: 100%; max-height: 250px;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3ª LINHA: ESTOQUE BAIXO E ÚLTIMAS MOVIMENTAÇÕES LADO A LADO -->
    <div class="row g-4">
        <div class="col-xl-6 col-lg-6">
            <div class="sb-section-card">
                <div class="sb-section-header text-danger">⚠️ Alerta: Estoque Baixo</div>
                <div class="card-body p-3" style="height: 240px; overflow-y: auto;">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var produto in Model)
                        {
                            int percent = produto.Quantidade * 20;
                            <div class="mb-2">
                                <div class="status-list-item">
                                    <span>@produto.Nome</span>
                                    <span class="text-danger fw-bold">@produto.Quantidade un</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 3px; background-color: #eaecf4;">
                                    <div class="progress-bar bg-danger" style="width: @percent%;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted mt-4" style="font-size: 0.9rem;">Nenhum produto crítico no momento.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-lg-6">
            <div class="sb-section-card">
                <div class="sb-section-header text-primary">📋 Últimas Movimentações</div>
                <div class="card-body p-0" style="height: 240px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-uppercase text-secondary" style="font-size: 0.75rem;">
                            <tr>
                                <th class="ps-3">Tipo</th>
                                <th>Produto</th>
                                <th class="pe-3 text-end">Qtd</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.UltimasMovimentacoes != null && ((List<OEletronico.Models.MovimentacaoEstoque>)ViewBag.UltimasMovimentacoes).Any())
                            {
                                @foreach (var mov in (List<OEletronico.Models.MovimentacaoEstoque>)ViewBag.UltimasMovimentacoes)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            @if (mov.Tipo == "Entrada") { <span class="badge bg-success">Entrada</span> }
                                            else { <span class="badge bg-warning text-dark">Saída</span> }
                                        </td>
                                        <td class="fw-bold text-dark">@(mov.Produto?.Nome ?? "Removido")</td>
                                        <td class="pe-3 text-end text-muted">@mov.Quantidade un</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-3 text-muted">Nenhuma movimentação.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- ⭐ ESSENCIAL: sem isso, o dropdown do filtro não abre/fecha nem posiciona certo -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        Chart.defaults.maintainAspectRatio = false;
        Chart.defaults.font.family = "'Nunito', sans-serif";
        Chart.defaults.color = '#858796';

        // Gráfico de Linha
        const ctxLine = document.getElementById('earningsChart').getContext('2d');
        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: ['Início', 'Parcial', 'Atual'],
                datasets: [{
                    label: 'Volume',
                    data: [0, @ViewBag.TotalEntradas, @ViewBag.TotalSaidas],
                    backgroundColor: 'rgba(78, 115, 232, 0.05)',
                    borderColor: '#4e73df',
                    borderWidth: 3,
                    pointBackgroundColor: '#4e73df',
                    pointBorderColor: '#4e73df',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#e3e6f0', borderDash: [2, 2] }, border: { display: false } },
                    x: { grid: { display: false }, border: { display: false } }
                }
            }
        });

        // Gráfico de Rosca
        const ctxDoughnut = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxDoughnut, {
            type: 'doughnut',
            data: {
                labels: ['Entradas', 'Saídas'],
                datasets: [{
                    data: [@ViewBag.TotalEntradas, @ViewBag.TotalSaidas],
                    backgroundColor: ['#1cc88a', '#4e73df'],
                    hoverBackgroundColor: ['#17a673', '#2e59d9'],
                }]
            },
            options: {
                responsive: true,
                cutout: '80%',
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true } }
                }
            }
        });
    </script>
}